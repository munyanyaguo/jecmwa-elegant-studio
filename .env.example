# ---------------------------------------------------------------------------
# JECMWA LIMITED — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only VITE_* vars are exposed to the browser bundle — keep secrets out of them.
# ---------------------------------------------------------------------------

# --- Supabase (client-side, safe to expose) --------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Site identity ----------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, sitemap and OG tags.
VITE_SITE_URL="https://jecmwa.com"

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
# Public site key. The secret key lives in Supabase Edge Function secrets.
VITE_TURNSTILE_SITE_KEY=""

# --- Analytics (optional, cookieless) ---------------------------------------
VITE_PLAUSIBLE_DOMAIN=""

# --- Error monitoring (optional) --------------------------------------------
VITE_SENTRY_DSN=""

# --- Seeding and migrations (LOCAL ONLY — never read by the browser bundle) ---
# Dashboard > Project Settings > API Keys > "secret" (or legacy service_role).
# Bypasses every RLS policy. Never commit, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Dashboard > Project Settings > General > Reference ID.
SUPABASE_PROJECT_ID=""

# Lets the CLI push migrations without an interactive login.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# The database password you set when creating the project.
# Dashboard > Project Settings > Database > Reset password, if you don't have it.
SUPABASE_DB_PASSWORD=""

# ---------------------------------------------------------------------------
# EDGE FUNCTION SECRETS — set with `npx supabase secrets set`, not here.
#
#   RESEND_API_KEY          Resend API key
#   ENQUIRY_NOTIFY_TO       Studio inbox that receives new enquiries
#   ENQUIRY_FROM_EMAIL      Verified sender, e.g. studio@jecmwa.com
#   ENQUIRY_SEND_CLIENT_COPY  "true" only once your domain is verified in Resend
#   TURNSTILE_SECRET_KEY    Cloudflare Turnstile secret
#   ALLOWED_ORIGINS         Comma-separated origins allowed to call the function
# ---------------------------------------------------------------------------
