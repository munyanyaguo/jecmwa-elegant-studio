# ---------------------------------------------------------------------------
# JECMWA LIMITED — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only VITE_* vars are exposed to the browser bundle — keep secrets out of them.
# ---------------------------------------------------------------------------

# --- Supabase (client-side, safe to expose) --------------------------------
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Site identity ----------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, sitemap and OG tags.
VITE_SITE_URL="https://jecmwa.com"

# --- Bot protection (Cloudflare Turnstile) ----------------------------------
# Public site key. The secret key lives in Supabase Edge Function secrets.
VITE_TURNSTILE_SITE_KEY=""

# --- Analytics (optional, cookieless) ---------------------------------------
VITE_PLAUSIBLE_DOMAIN=""

# --- Error monitoring (optional) --------------------------------------------
VITE_SENTRY_DSN=""

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets, never here.
#   supabase secrets set RESEND_API_KEY=...
#
#   RESEND_API_KEY          Resend API key
#   ENQUIRY_NOTIFY_TO       Studio inbox that receives new enquiries
#   ENQUIRY_FROM_EMAIL      Verified sender, e.g. studio@jecmwa.com
#   ENQUIRY_SEND_CLIENT_COPY  "true" only once your domain is verified in Resend
#   TURNSTILE_SECRET_KEY    Cloudflare Turnstile secret
#   SUPABASE_SERVICE_ROLE_KEY  Injected automatically by Supabase
# ---------------------------------------------------------------------------
